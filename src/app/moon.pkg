import {
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
}

// The IFDS SPIKE's driver (`src/app/ifds_spike_wbtest.mbt`) needs the async
// runtime -- to read a module tree from a test, which is the only way in this
// core to touch the filesystem -- and the environment, to name the corpus and
// to time the run.
//
// They are imported FOR THE WBTEST ONLY, so the published library declares no
// dependency it does not use: a white-box test file is not part of the
// published library, and a package only it uses would otherwise be reported
// as unused by the library build.
import {
  "moonbitlang/core/async",
  "moonbitlang/core/env",
} for "wbtest"

// The property-based tests import the toolchain's OWN `quickcheck` package --
// the one inside the `moonbitlang/core` the toolchain bundles -- and nothing
// else. It is imported FOR TESTS ONLY, so `moon.mod` keeps its empty import
// block, the published library declares no dependency, and the published
// artifact is byte-identical with and without these tests.
//
// The registry module `moonbitlang/quickcheck` would have needed an import
// block in `moon.mod`, which is the thing this module's whole architecture
// avoids: the runtime comes from the toolchain, so nothing can drift.
import {
  "moonbitlang/core/quickcheck" @coreqc,
} for "test"

// The async runtime comes from the toolchain-bundled `moonbitlang/core`
// module, and `moonbitlang/core/async` is EXPERIMENTAL there: using it has
// to be acknowledged, or the build refuses it.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/process",
  ],
)
