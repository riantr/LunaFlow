# Build output
_build/

# Fetched registry modules and the vendored dependency tree
.repos/
.mooncakes/
.moon/

# Tooling and editor scratch
.arts/
.codeartsdoer/
.DS_Store
Thumbs.db

# Python bytecode. The CI scripts under `.github/scripts/` are Python, and
# importing one -- which the README-sync test does -- writes a `__pycache__`
# next to it.
__pycache__/
*.py[cod]

# Root-level QA scratch only. The pattern is anchored on purpose: a bare
# `qa/` would also match `scripts/qa/`, and the harness has to be committed.
# The harnesses write their working directories under `_build/qa/`.
/qa/

# The coverage reporter writes its report into the CURRENT directory, so a
# `moon coverage report -f <format>` run leaves these at the repository root.
# They are outputs, not sources, and they are not worth reviewing.
/bisect.coverage
/cobertura.xml
/coveralls.json
/_coverage/

# THE RAW TRACES ARE EVIDENCE, NOT PACKAGE.
#
# `moon publish` packs the working tree minus the files the ignore rules
# match, and the registry refuses an archive it cannot read: the 0.1.35
# upload was rejected with "400 Bad Request, detail: Invalid ZIP archive"
# because the package carried 162,703,756 bytes of unpacked content and an
# 80,863,997-byte entry, where the largest archive the registry had
# accepted (0.1.34, read from the registry's own copy) carried 46,274,868
# bytes and a 39,479,846-byte entry. The report, the sidecar and the
# summary -- the artefacts a reader uses -- are small, and they stay.
#
# The traces stay in the repository, and they stay tracked: a trace that a
# new corpus produces is committed with `git add -f` -- and when one of them
# is missing from the index, the package envelope check says WHICH ignore rule
# matched it and prints the command that stages it.
/reports/*_trace.jsonl
